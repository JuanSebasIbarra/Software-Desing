      "name": "Libros - Pruebas guiadas",
      "description": "Flujo principal solicitado para probar el CRUD de libros.",
      "item": [
        {
          "name": "Prueba 1 - Crear un libro",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code es 201', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "var jsonData = pm.response.json();",
                  "",
                  "pm.test('La respuesta contiene el libro creado', function () {",
                  "    pm.expect(jsonData).to.have.property('id');",
                  "    pm.expect(jsonData.isbn).to.eql('978-0-13-468599-1');",
                  "    pm.expect(jsonData.titulo).to.eql('Clean Code');",
                  "    pm.expect(jsonData.autor).to.eql('Robert C. Martin');",
                  "    pm.expect(jsonData.anioPublicacion).to.eql(2008);",
                  "    pm.expect(jsonData.categoria).to.eql('Programación');",
                  "});",
                  "",
                  "pm.collectionVariables.set('libroId', jsonData.id);",
                  "console.log('libroId guardado en variables de colección:', jsonData.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"isbn\": \"978-0-13-468599-1\",\n  \"titulo\": \"Clean Code\",\n  \"autor\": \"Robert C. Martin\",\n  \"anioPublicacion\": 2008,\n  \"categoria\": \"Programación\"\n}",
              "options": {
